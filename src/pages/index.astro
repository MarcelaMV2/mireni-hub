---
import { getCollection } from "astro:content";
import Layout from "../componentes/Layout.astro";
import MateriaCard from "../componentes/MateriaCard.astro";
import Perfil from "../componentes/Perfil.astro";
import PortadaFondo from "../componentes/PortadaFondo.astro";
import "../estilos/portada.css";

const materias = (await getCollection("materias")).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const semanas = await getCollection("semanas");
const ejercicios = (await getCollection("ejercicios")).filter(
  (e) => e.data.publicado,
);
const clases = await getCollection("clases");

function conteo(sigla: string) {
  return {
    semanas: semanas.filter((s) => s.data.materia.id === sigla).length,
    ejercicios:
      ejercicios.filter((e) => e.data.materia.id === sigla).length +
      clases
        .filter((c) => c.data.materia.id === sigla)
        .reduce((total, c) => total + c.data.cantidadEjercicios, 0),
  };
}
---

<Layout
  titulo="Welcome to Mireni Hub · Marcela Miranda Veniz"
  descripcion="Ejercicios resueltos de las materias en las que soy auxiliar de docencia."
  variante="portada"
>
  <PortadaFondo />
  <div class="portada-wrap portada-content">
    <Perfil />
  </div>
  <section id="materias" class="portada-subjects">
    <div class="portada-wrap">
      <h2>Materias</h2>
      <p>Busca tu materia, revisa el contenido y sigue avanzando.</p>
      <div class="portada-grid">
        {
          materias.map((m) => {
            const c = conteo(m.id);
            return (
              <MateriaCard
                sigla={m.data.sigla}
                nombre={m.data.nombre}
                descripcion={m.data.descripcion}
                icono={m.data.icono}
                acento={m.data.acento}
                semanas={c.semanas}
                ejercicios={c.ejercicios}
                href={`/${m.id}`}
                meta={m.data.meta}
                destacada={true}
              />
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
