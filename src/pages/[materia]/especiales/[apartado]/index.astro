---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Icon } from 'astro-icon/components';
import Layout from '../../../../componentes/Layout.astro';
import Breadcrumb from '../../../../componentes/Breadcrumb.astro';
import EjercicioCard from '../../../../componentes/EjercicioCard.astro';
import Codigo from '../../../../componentes/mdx/Codigo.astro';
import '../../../../estilos/contenido.css';

export const getStaticPaths = (async () => {
  const materias = await getCollection('materias');
  const apartados = await getCollection('apartados');
  return apartados.map((a) => {
    const materia = materias.find((m) => m.id === a.data.materia.id)!;
    return {
      params: { materia: materia.id, apartado: a.id.split('/').pop()! },
      props: { materia, apartado: a },
    };
  });
}) satisfies GetStaticPaths;

const { materia, apartado } = Astro.props;

const retos = (await getCollection('retos'))
  .filter((r) => r.data.apartado.id === apartado.id)
  .sort((a, b) => a.data.numero - b.data.numero);

const gruposLabel: Record<'I' | 'II', string> = {
  I: 'Grupo I · Módulo tipo función',
  II: 'Grupo II · Módulo',
};
const grupos = (['I', 'II'] as const)
  .map((g) => ({ g, items: retos.filter((r) => r.data.grupo === g) }))
  .filter((x) => x.items.length > 0);

const slugAp = apartado.id.split('/').pop()!;
const esPrimerParcial = slugAp === 'prep-primer-parcial';
const esSegundoParcial = slugAp === 'prep-segundo-parcial';
const esParcialSis100 = esPrimerParcial && materia.id === 'sis100';
const esSegundoParcialSis304 = esSegundoParcial && materia.id === 'sis304';
const esPractica = apartado.data.tipo === 'practica';
const imagenesParcial = esPrimerParcial
  ? (esParcialSis100
      ? [1, 2, 3, 4].map((n) => `/material/sis100/parcial1/p${n}.png`)
      : [1, 2, 3].map((n) => `/material/sis304/parcial1/pp${n}.jpeg`))
  : [];
const tieneContenidoPropio = imagenesParcial.length > 0 || esSegundoParcialSis304;
const leerSqlParcial2 = (archivo: string) =>
  readFileSync(join(process.cwd(), 'public/material/sis304/parcial2', archivo), 'utf-8');
const sqlBd1 = esSegundoParcialSis304 ? leerSqlParcial2('bd1.sql') : '';
const sqlBd2 = esSegundoParcialSis304 ? leerSqlParcial2('bd2.sql') : '';
---

<Layout titulo={`${apartado.data.titulo} · ${materia.data.sigla}`} marcaDerecha={apartado.data.titulo}>
  <div class="max-w-[880px] mx-auto px-4 md:px-8">

    <header class:list={['flex flex-col gap-3 pt-8 pb-6 border-b-2', esPractica ? 'border-success' : 'border-warning']}>
      <Breadcrumb
        items={[
          { texto: 'Inicio', href: '/' },
          { texto: materia.data.sigla, href: `/${materia.id}` },
          { texto: apartado.data.titulo },
        ]}
      />

      <div class="flex items-center gap-4">
        <span class:list={['grid place-items-center w-14 h-14 shrink-0 rounded-md border-2', esPractica ? 'border-success text-success' : 'border-warning text-warning']}>
          <Icon name={esPractica ? 'tabler:pencil' : 'tabler:sun'} width={24} height={24} />
        </span>
        <h1 class="font-heading uppercase tracking-tight leading-[0.9] text-[clamp(1.9rem,6vw,3.2rem)]">
          {apartado.data.titulo}
        </h1>
      </div>

      <div class="flex gap-2 flex-wrap">
        <span class="font-mono text-xs uppercase tracking-widest border border-default rounded-md px-2.5 py-1 text-secondary">
          {materia.data.sigla} · {materia.data.nombre}
        </span>
        <span class="font-mono text-xs uppercase tracking-widest border border-default rounded-md px-2.5 py-1 text-secondary">
          {imagenesParcial.length > 0
            ? `${imagenesParcial.length} láminas de repaso`
            : esSegundoParcialSis304
              ? '3 láminas · 2 scripts SQL'
              : `${retos.length} ejercicios`}
        </span>
        <span class="font-mono text-xs uppercase tracking-widest border border-default rounded-md px-2.5 py-1 text-secondary">
          {esParcialSis100 ? 'Teoría · Práctica' : materia.id === 'sis304' ? 'Modelo · SQL' : 'Diagrama de flujo · Prueba de escritorio'}
        </span>
      </div>
    </header>

    {esParcialSis100 && (
      <aside class="mt-8 border-l-4 border-success bg-surface p-5 sm:p-6" aria-labelledby="recomendaciones-parcial">
        <h2 id="recomendaciones-parcial" class="font-heading text-2xl uppercase tracking-wide">¡A poner en práctica lo aprendido!</h2>
        <p class="mt-3 leading-relaxed">También habrá <strong>parte teórica</strong>: repasen los conceptos, las variables, los operadores y cómo funcionan las estructuras selectivas y repetitivas.</p>
        <p class="mt-3 leading-relaxed">Practiquen con los ejercicios de estas imágenes y de las semanas anteriores. Identifiquen los <strong>datos de entrada y salida</strong>, escriban su análisis y comprueben el algoritmo con una prueba de escritorio y ejecutando el programa.</p>
        <p class="mt-3 leading-relaxed">Intenten resolverlos antes de consultar las soluciones y prueben datos válidos e inválidos. <strong>¡Mucho éxito!</strong></p>
      </aside>
    )}

    {esSegundoParcialSis304 && (
      <section class="mt-8 border-t-2 border-primary pt-4" aria-labelledby="segundo-parcial-material">
        <p class="text-xs uppercase tracking-widest text-secondary mb-3">
          Prepárate para el reto
        </p>

        <div class="flex flex-col gap-8">
          <figure>
            <figcaption class="mb-2 font-mono text-xs uppercase tracking-widest">
              Lámina 01
            </figcaption>
            <a href="/material/sis304/parcial2/imagen1.jpeg" target="_blank" rel="noopener noreferrer" aria-label="Abrir la lámina 1 del segundo parcial en otra pestaña">
              <img
                src="/material/sis304/parcial2/imagen1.jpeg"
                alt={`Lámina 1 del segundo parcial de ${materia.data.sigla}`}
                loading="lazy"
                class="mx-auto block max-h-[70vh] w-full border border-default bg-surface-muted object-contain p-2"
              />
            </a>
          </figure>

          <Codigo archivo="bd1.sql" lang="sql" codigo={sqlBd1} plegado />

          <figure>
            <figcaption class="mb-2 font-mono text-xs uppercase tracking-widest">
              Lámina 02
            </figcaption>
            <a href="/material/sis304/parcial2/imagen2.jpeg" target="_blank" rel="noopener noreferrer" aria-label="Abrir la lámina 2 del segundo parcial en otra pestaña">
              <img
                src="/material/sis304/parcial2/imagen2.jpeg"
                alt={`Lámina 2 del segundo parcial de ${materia.data.sigla}`}
                loading="lazy"
                class="mx-auto block max-h-[70vh] w-full border border-default bg-surface-muted object-contain p-2"
              />
            </a>
          </figure>

          <figure>
            <figcaption class="mb-2 font-mono text-xs uppercase tracking-widest">
              Lámina 03
            </figcaption>
            <a href="/material/sis304/parcial2/imagen3.jpeg" target="_blank" rel="noopener noreferrer" aria-label="Abrir la lámina 3 del segundo parcial en otra pestaña">
              <img
                src="/material/sis304/parcial2/imagen3.jpeg"
                alt={`Lámina 3 del segundo parcial de ${materia.data.sigla}`}
                loading="lazy"
                class="mx-auto block max-h-[70vh] w-full border border-default bg-surface-muted object-contain p-2"
              />
            </a>
          </figure>

          <Codigo archivo="bd2.sql" lang="sql" codigo={sqlBd2} plegado />
        </div>
      </section>
    )}

    {imagenesParcial.length > 0 && (
      <section class="mt-8 border-t-2 border-primary pt-4">
        <p class="text-xs uppercase tracking-widest text-secondary mb-3">
          Prepárate para el reto
        </p>

        <div class="flex flex-col gap-2">
          {imagenesParcial.map((src, indice) => (
            <details class="group border border-default rounded-md overflow-hidden">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-4 py-3 font-mono text-sm uppercase tracking-widest hover:bg-surface-muted transition-colors">
                <span>{esParcialSis100 ? 'Práctica' : 'Registro'} {String(indice + 1).padStart(2, '0')}</span>
                <Icon
                  name="tabler:plus"
                  width={20}
                  height={20}
                  class="shrink-0 transition-transform duration-150 group-open:rotate-45"
                />
              </summary>
              <div class="border-t border-default bg-surface-muted p-3 md:p-5">
                <img
                  src={src}
                  alt={`Lámina ${indice + 1} de ejercicios para preparar el primer parcial de ${materia.data.sigla}`}
                  loading="lazy"
                  class="mx-auto block max-h-[70vh] w-full object-contain"
                />
                {materia.id === 'sis304' && esPrimerParcial && indice === 0 && (
                  <a
                    href="/sis304/especiales/prep-primer-parcial/ejercicio-3"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex items-center gap-2 bg-primary text-canvas font-mono text-xs uppercase tracking-widest px-4 py-3 transition-colors hover:bg-brand"
                  >
                    Resolución
                    <Icon name="tabler:arrow-up-right" width={16} height={16} />
                  </a>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    {retos.length === 0 ? (!tieneContenidoPropio && (
      <p class="mt-8 text-secondary">
        Todavía no hay ejercicios cargados en este apartado.
      </p>
    )) : (
      grupos.map((bloque) => (
        <section class="mt-10">
          <p class="font-mono text-xs uppercase tracking-widest text-warning mb-4">
            {gruposLabel[bloque.g]}
          </p>

          <div class="flex flex-col gap-4">
            {bloque.items.map((r) => (
              <EjercicioCard
                numero={r.data.numero}
                prefijo={`${bloque.g}.`}
                titulo={r.data.titulo}
                descripcion={r.data.descripcion}
                etiqueta="Diagrama de flujo"
                tags={['Diagrama de flujo', 'Prueba de escritorio']}
                accion="Ver ejercicio"
                href={`/${materia.id}/especiales/${slugAp}/${r.id.split('/').pop()}`}
              />
            ))}
          </div>
        </section>
      ))
    )}

  </div>
</Layout>
