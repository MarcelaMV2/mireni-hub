---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import Layout from "../../componentes/Layout.astro";
import MateriaFondo from "../../componentes/MateriaFondo.astro";
import Breadcrumb from "../../componentes/Breadcrumb.astro";
import SemanaCard from "../../componentes/SemanaCard.astro";
import ApartadoCard from "../../componentes/ApartadoCard.astro";
import "../../estilos/materia.css";

export const getStaticPaths = (async () => {
  const materias = await getCollection("materias");
  return materias.map((m) => ({
    params: { materia: m.id },
    props: { materia: m },
  }));
}) satisfies GetStaticPaths;

const { materia } = Astro.props;

const semanas = (await getCollection("semanas"))
  .filter((s) => s.data.materia.id === materia.id)
  .sort((a, b) => a.data.numero - b.data.numero);

const apartados = (await getCollection("apartados"))
  .filter((a) => a.data.materia.id === materia.id)
  .sort((a, b) => a.data.orden - b.data.orden);

const materialExtra = (await getCollection("material")).find(
  (m) => m.data.materia.id === materia.id,
);

const iconos = {
  db: "tabler:database",
  code: "tabler:code",
};

function slugSemana(id: string) {
  return id.split("/").pop()!;
}
---

<Layout
  titulo={`${materia.data.nombre} · ${materia.data.sigla}`}
  variante="materia"
>
  <MateriaFondo />
  <div class="materia-main">
    <div class="materia-wrap">
      <section class="materia-head">
        <Breadcrumb
          items={[
            { texto: "Inicio", href: "/" },
            { texto: materia.data.sigla },
          ]}
        />
        <div class="materia-title">
          <span class="materia-title-icon">
            <Icon name={iconos[materia.data.icono]} width={30} height={30} />
          </span>
          <h1>{materia.data.nombre}</h1>
        </div>
        <p class="materia-description">
          {materia.data.descripcion} Cada semana trae los ejercicios de la clase con
          su resolución.
        </p>
        {
          materialExtra && (
            <a class="materia-material" href={`/${materia.id}/material`}>
              <Icon name="tabler:photo" width={16} height={16} />
              Ver material extra
            </a>
          )
        }
      </section>

      <section aria-labelledby="semanas-title">
        <div class="materia-bar">
          <div>
            <h2 id="semanas-title">Clases por semana</h2>
            <small data-week-count>{semanas.length} semanas publicadas</small>
          </div>
          <label class="materia-search">
            <Icon name="tabler:search" width={18} height={18} />
            <input
              data-week-search
              type="search"
              placeholder="Buscar un tema, por ejemplo triggers"
              aria-label="Buscar en las semanas"
              autocomplete="off"
            />
          </label>
        </div>

        <ol class="materia-weeks" data-week-list>
          {
            semanas.map((s) => (
              <li
                data-week-item
                data-search-text={`${s.data.titulo} ${s.data.resumen}`}
              >
                <SemanaCard
                  numero={s.data.numero}
                  titulo={s.data.titulo}
                  resumen={s.data.resumen}
                  estado={s.data.estado}
                  href={`/${materia.id}/${slugSemana(s.id)}`}
                />
              </li>
            ))
          }
        </ol>
        <p class="materia-empty" data-week-empty>
          No hay semanas con ese tema. Prueba con otra palabra.
        </p>
      </section>

      {
        apartados.length > 0 && (
          <section class="materia-special">
            <h2>Apartados especiales</h2>
            <div class="materia-special-grid">
              {apartados.map((a) => (
                <ApartadoCard
                  tipo={a.data.tipo}
                  titulo={a.data.titulo}
                  subtitulo={a.data.subtitulo}
                  href={`/${materia.id}/especiales/${a.id.split("/").pop()}`}
                />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </div>

  <script>
    const search = document.querySelector("[data-week-search]");
    const items = Array.from(document.querySelectorAll("[data-week-item]"));
    const count = document.querySelector("[data-week-count]");
    const empty = document.querySelector("[data-week-empty]");

    const normalize = (value: string) =>
      value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");

    if (search instanceof HTMLInputElement && count && empty) {
      const update = () => {
        const term = normalize(search.value.trim());
        let visible = 0;
        items.forEach((item) => {
          const matches =
            !term ||
            normalize(item.getAttribute("data-search-text") || "").includes(
              term,
            );
          item.toggleAttribute("hidden", !matches);
          if (matches) visible += 1;
        });
        count.textContent = term
          ? `${visible} de ${items.length} semanas`
          : `${items.length} semanas publicadas`;
        empty.classList.toggle("is-visible", visible === 0);
      };
      search.addEventListener("input", update);
    }
  </script>
</Layout>
