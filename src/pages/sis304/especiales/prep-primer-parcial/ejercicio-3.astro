---
import Layout from '../../../../componentes/Layout.astro';
import Breadcrumb from '../../../../componentes/Breadcrumb.astro';
import Codigo from '../../../../componentes/mdx/Codigo.astro';

const apartado = '/sis304/especiales/prep-primer-parcial';
const codigo = `CREATE DATABASE BOTINES
CHARACTER SET utf8 COLLATE utf8_general_ci;

USE BOTINES;

CREATE TABLE IF NOT EXISTS BOTIN(
CODIGO CHAR(6) NOT NULL PRIMARY KEY,
DESCRIPCION VARCHAR(50) NOT NULL,
TALLA INT(3), CHECK (TALLA >=10 AND TALLA<=999),
INDUSTRIA VARCHAR(50) NULL
) ENGINE = InnoDB;

CREATE TABLE CLASICO(
CODIGO CHAR(6) NOT NULL PRIMARY KEY,
MATERIAL VARCHAR(50) NOT NULL,
COLOR ENUM('CAFE','MARRON','NEGRO','CHAROL','BLANCO'),
FOREIGN KEY(CODIGO) REFERENCES BOTIN(CODIGO)
) ENGINE = InnoDB;

CREATE TABLE INDUSTRIAL(
CODIGO CHAR(6) NOT NULL PRIMARY KEY,
MODELO VARCHAR(50) DEFAULT " ",
FOREIGN KEY(CODIGO) REFERENCES BOTIN(CODIGO)
) ENGINE = InnoDB;

CREATE TABLE CLIENTE(
CI CHAR(10) NOT NULL PRIMARY KEY,
NOMBRE VARCHAR(50) NOT NULL,
DIRECCION VARCHAR(50) NULL,
CELULAR INT(8) NOT NULL
) ENGINE = InnoDB;

CREATE TABLE VENDEDOR(
ITEM INT(4) AUTO_INCREMENT PRIMARY KEY,
NOMBRE VARCHAR(50) NOT NULL,
TELEFONO CHAR(10) NOT NULL,
CIUDAD VARCHAR(30) NULL
) ENGINE=InnoDB AUTO_INCREMENT=100;

CREATE TABLE SUPERVISION(
ITEM INT(4) NOT NULL,
ITEMS INT(4) NOT NULL,
FECHA DATETIME DEFAULT NOW(),
PRIMARY KEY(ITEM,ITEMS),
FOREIGN KEY (ITEM) REFERENCES VENDEDOR(ITEM),
FOREIGN KEY (ITEMS) REFERENCES VENDEDOR(ITEM)
) ENGINE = InnoDB;

CREATE TABLE VENTA(
CODIGO CHAR(6) NOT NULL,
ITEM INT(4) NOT NULL,
CI CHAR(10) NOT NULL,
FECHA DATETIME, CHECK( YEAR(FECHA) = 2019),
COSTO FLOAT(6,2) DEFAULT 0.0,
IMPUESTO FLOAT(6,2), CHECK( IMPUESTO = COSTO * 0.15),
PRIMARY KEY(CODIGO,ITEM,CI),
FOREIGN KEY(CODIGO) REFERENCES BOTIN(CODIGO),
FOREIGN KEY (ITEM) REFERENCES VENDEDOR(ITEM),
FOREIGN KEY (CI) REFERENCES CLIENTE(CI)
) ENGINE = InnoDB;

SELECT * FROM VENTA;
SELECT * FROM CLIENTE;
SELECT * FROM VENDEDOR;
INSERT INTO VENDEDOR(NOMBRE,TELEFONO) VALUES('MARCELA MIRANDA','12345678');
INSERT INTO VENDEDOR(NOMBRE,TELEFONO) VALUES('EMANUEL FLORES','12905678');`;
---

<Layout titulo="Resolución · Registro 01 · SIS304" descripcion="Resoluciones de las tres preguntas del Registro 01 del primer parcial de SIS304." marcaDerecha="SIS304">
  <article class="max-w-[880px] mx-auto px-4 md:px-8">
    <header class="flex flex-col gap-3 pt-8 pb-6 border-b-2 border-warning">
      <Breadcrumb items={[
        { texto: 'Inicio', href: '/' },
        { texto: 'SIS304', href: '/sis304' },
        { texto: 'Prep. Primer Parcial', href: apartado },
        { texto: 'Resolución' },
      ]} />
      <p class="font-mono text-xs uppercase tracking-widest text-secondary">Registro 01 · Primer parcial</p>
      <h1 class="font-heading uppercase tracking-tight leading-[0.9] text-[clamp(1.9rem,6vw,3.2rem)]">Resolución</h1>
    </header>

    <section class="mt-8" aria-labelledby="resolucion-1">
      <h2 id="resolucion-1" class="font-heading uppercase text-2xl">Resolución pregunta 1</h2>
      <p class="mt-3 text-secondary leading-relaxed">El ejercicio pide el <strong>MOS</strong>, que es la respuesta que deben presentar. Para llegar a él de manera clara, primero identifiquen los objetos, sus atributos y las relaciones binarias; luego elaboren el grafo de relaciones. Así podrán organizar la información del enunciado y comprender cómo se relacionan los objetos antes de construir el MOS.</p>
      <p class="mt-3 text-secondary leading-relaxed">Si lo necesitan, también pueden elaborar el <strong>MER</strong> como apoyo. El enunciado no pide estos pasos previos como parte de la entrega, pero realizarlos puede ayudarles a construir el MOS con mayor seguridad. Si ya logran identificar correctamente los objetos, atributos y relaciones y obtener el MOS directamente, no hay problema: lo importante es que comprendan y representen bien el modelo.</p>
      <p class="mt-3 text-secondary leading-relaxed">Primero se muestra el MOS y, a continuación, las dos imágenes de apoyo. Pueden abrir cada imagen para verla en tamaño completo.</p>
      <div class="mt-4 grid grid-cols-3 items-start gap-2 sm:gap-4">
        {[
          { titulo: 'MOS', imagen: 'mos.jpeg' },
          { titulo: 'Apoyo · r1', imagen: 'r1.jpeg' },
          { titulo: 'Apoyo · r2', imagen: 'r2.jpeg' },
        ].map(({ titulo, imagen }) => (
          <figure class="min-w-0">
            <figcaption class="mb-2 font-mono text-xs uppercase tracking-widest">{titulo}</figcaption>
            <a href={`/material/sis304/parcial1/${imagen}`} target="_blank" rel="noopener noreferrer" aria-label={`${titulo}: abrir imagen en tamaño completo en otra pestaña`}>
              <img
                src={`/material/sis304/parcial1/${imagen}`}
                alt={`${titulo} de la resolución de la pregunta 1 de SIS304`}
                loading="lazy"
                class="block w-full h-auto"
              />
            </a>
          </figure>
        ))}
      </div>
    </section>

    <section class="mt-8" aria-labelledby="resolucion-2">
      <h2 id="resolucion-2" class="font-heading uppercase text-2xl">Resolución ejercicio 2</h2>
      <p class="mt-3 text-secondary leading-relaxed"><strong>Enunciado:</strong> Elaborar únicamente el <strong>MLGD</strong> a partir del modelo proporcionado. Ese es el resultado que deben presentar en este ejercicio.</p>
      <img
        src="/material/sis304/parcial1/r3.jpeg"
        alt="Resolución ejercicio 2 del Registro 01 de SIS304"
        loading="lazy"
        class="mt-4 mx-auto block w-full h-auto"
      />
    </section>

    <section class="mt-8" aria-labelledby="resolucion">
      <h2 id="resolucion" class="font-heading uppercase text-2xl">Resolución ejercicio 3</h2>
      <p class="mt-3 text-secondary leading-relaxed"><strong>Enunciado:</strong> A partir del MLGD proporcionado, <strong>crear la base de datos BOTINES en MySQL</strong>, incluyendo sus tablas y relaciones. La resolución consiste en los comandos SQL necesarios para crearla.</p>
      <Codigo archivo="botines.sql" lang="sql" codigo={codigo} />
    </section>

    <section class="mt-8" aria-labelledby="limpieza">
      <h2 id="limpieza" class="font-heading uppercase text-2xl">Limpieza opcional</h2>
      <p class="mt-3 text-secondary leading-relaxed">Este comando elimina la tabla VENTA y sus datos. Ejecútalo únicamente si deseas borrarla al terminar la práctica.</p>
      <Codigo archivo="limpieza.sql" lang="sql" codigo="DROP TABLE VENTA;" />
    </section>

    <footer class="mt-12 pt-4 border-t border-default font-mono text-xs uppercase tracking-widest">
      <a href={apartado} class="text-secondary hover:text-primary">← Volver a Prep. Primer Parcial</a>
    </footer>
  </article>
</Layout>
