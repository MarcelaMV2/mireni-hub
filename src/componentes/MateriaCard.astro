---
import { Icon } from "astro-icon/components";

interface Props {
  sigla: string;
  nombre: string;
  descripcion: string;
  icono: "db" | "code";
  acento?: string;
  semanas: number;
  ejercicios: number;
  href: string;
  meta?: string[];
  destacada?: boolean;
}

const {
  sigla,
  nombre,
  descripcion,
  icono,
  semanas,
  ejercicios,
  href,
  meta = [],
  destacada = true,
} = Astro.props;

const iconos = {
  db: "tabler:database",
  code: "tabler:code",
};
---

<a href={href} id={sigla.toLowerCase()} class="portada-card group">
  <div class="portada-card-top">
    <span class="portada-card-icon">
      <Icon name={iconos[icono]} width={22} height={22} />
    </span>
    <span class="portada-chip">{sigla}</span>
  </div>
  <h2>{nombre}</h2>
  <p>{descripcion}</p>
  <ul class="portada-tags">
    {meta.slice(0, 4).map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="portada-card-open">
    <span>Ver ejercicios</span>
    <Icon name="tabler:arrow-up-right" width={18} height={18} />
  </div>
</a>
