---
import { perfil } from "../config/sitio";
import RedesSociales from "./RedesSociales.astro";
---

<section class="portada-hero" id="inicio">
  <div class="portada-hero-copy">
    <span class="portada-badge"
      ><span aria-hidden="true">▣</span> Repositorio de Auxiliatura</span
    >
    <h1>Welcome to<br />Mireni Hub</h1>
    <p class="portada-by">by {perfil.nombre} {perfil.apellido}</p>
    <p class="portada-lead">{perfil.bio}</p>
    <div class="portada-contact" id="contacto">
      <RedesSociales />
    </div>
  </div>
</section>
