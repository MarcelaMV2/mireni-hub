---
interface Item {
  texto: string;
  href?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<nav class="site-breadcrumb" aria-label="Ruta">
  {
    items.map((it, i) => (
      <>
        {it.href ? (
          <a href={it.href}>{it.texto}</a>
        ) : (
          <span class="current">{it.texto}</span>
        )}
        {i < items.length - 1 && (
          <span class="separator" aria-hidden="true">
            ›
          </span>
        )}
      </>
    ))
  }
</nav>
