---
interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="my-6 min-w-0">
  <figcaption class="flex items-center gap-2 font-heading uppercase text-xl mb-4 leading-tight">
    <span class="w-3 h-3 bg-brand shrink-0"></span>
    Diagrama de flujo
  </figcaption>
  <div class="grid place-items-center bg-white border border-default rounded-md p-3 sm:p-4">
    <img src={src} alt={alt} loading="lazy" class="block w-full h-auto object-contain" />
  </div>
</figure>
