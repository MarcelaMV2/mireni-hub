---
import { Icon } from 'astro-icon/components';

interface Props {
  modelo: string;
}

const { modelo } = Astro.props;
---

<section class="mt-6 min-w-0">
  <div class="flex items-center gap-2 font-heading uppercase text-xl mb-4 leading-tight">
    <span class="w-3 h-3 bg-brand shrink-0"></span>
    Resultado · {modelo}
  </div>
  <div
    class="grid place-items-center h-[240px] sm:h-[280px] rounded-md border border-dashed border-default p-4 sm:p-5 text-center"
    style="background: repeating-linear-gradient(45deg, var(--color-surface), var(--color-surface) 10px, #f0ece3 10px, #f0ece3 20px);"
  >
    <div class="max-w-full bg-canvas/90 border border-default rounded-md px-4 py-5">
      <Icon name="tabler:tools-kitchen-2" width={32} height={32} class="mx-auto text-brand" />
      <p class="font-heading uppercase text-lg mt-3">El {modelo} se está cocinando…</p>
      <p class="font-mono text-xs uppercase tracking-widest text-secondary mt-2">
        Resolución disponible próximamente
      </p>
    </div>
  </div>
</section>
