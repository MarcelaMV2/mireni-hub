---
import { Code } from "astro:components";

// Bloque de código con título de archivo, botón copiar y resaltado (Shiki).
// Uso en MDX:
//   <Codigo archivo="sp_stock_categoria.sql" lang="sql" codigo={`CREATE PROCEDURE ...`} />
// Con `plegado` el bloque arranca contraído (se despliega con el botón
// "plegar"), útil para no mostrar la resolución a simple vista.
import { Icon } from "astro-icon/components";

interface Props {
  archivo: string;
  lang: string;
  codigo: string;
  plegado?: boolean;
}
const { archivo, lang, codigo, plegado = false } = Astro.props;
---

<figure
  class:list={["code-editor", plegado && "is-closed"]}
  data-code-editor
>
  <figcaption class="code-editor-head">
    <span class="code-editor-dots" aria-hidden="true"
      ><i></i><i></i><i></i></span
    >
    <span class="code-editor-file">{archivo}</span>
    <span class="code-editor-lang">{lang === "sql" ? "MySQL" : lang}</span>
    <div class="code-editor-tools">
      <button
        class="code-editor-tool copiar"
        data-codigo={codigo}
        type="button"
        aria-label="Copiar código"
      >
        <Icon name="tabler:copy" width={16} height={16} class="icono-copiar" />
        <Icon
          name="tabler:check"
          width={16}
          height={16}
          class="icono-ok hidden"
        />
        <span class="texto-btn">Copiar</span>
      </button>
      <button
        class="code-editor-tool plegar"
        type="button"
        aria-label="Contraer o expandir código"
        aria-expanded={!plegado}
      >
        <Icon name="tabler:chevron-up" width={16} height={16} />
      </button>
    </div>
  </figcaption>
  <div class="code-editor-body">
    <div class="code-editor-code code-editor-code-dark">
      <Code code={codigo} lang={lang as any} theme="github-dark" />
    </div>
    <div class="code-editor-code code-editor-code-light">
      <Code code={codigo} lang={lang as any} theme="github-light" />
    </div>
  </div>
  <figcaption class="code-editor-foot">
    <span
      >{codigo.split("\n").length}
      {codigo.split("\n").length === 1 ? "línea" : "líneas"}</span
    >
    <span>UTF-8</span>
  </figcaption>
</figure>

<script>
  document.querySelectorAll(".code-editor").forEach((editor) => {
    const fold = editor.querySelector(".plegar");
    fold?.addEventListener("click", () => editor.classList.toggle("is-closed"));
  });

  document.querySelectorAll(".code-editor .copiar").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const codigo = btn.getAttribute("data-codigo") ?? "";
      const iconoCopiar = btn.querySelector(".icono-copiar");
      const iconoOk = btn.querySelector(".icono-ok");
      const texto = btn.querySelector(".texto-btn");
      try {
        await navigator.clipboard.writeText(codigo);
        iconoCopiar?.classList.add("hidden");
        iconoOk?.classList.remove("hidden");
        if (texto) texto.textContent = "Copiado";
        btn.classList.add("!text-success", "!border-success");
        setTimeout(() => {
          iconoCopiar?.classList.remove("hidden");
          iconoOk?.classList.add("hidden");
          if (texto) texto.textContent = "Copiar código";
          btn.classList.remove("!text-success", "!border-success");
        }, 1600);
      } catch {
        /* clipboard no disponible */
      }
    });
  });
</script>
