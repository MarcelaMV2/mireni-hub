        >
        <text class="portada-face-text" x="14" y="78" opacity=".75"
          >FOR EACH ROW</text
        >
        <text class="portada-face-text" x="14" y="94">BEGIN</text>
        <text class="portada-face-text" x="14" y="110" opacity=".6">
          INSERT INTO</text
        >
        <text class="portada-face-text" x="14" y="126">END;</text>
      </g>
      <g transform="matrix(1 -0.577 0 1 260 280)">
        <text class="portada-face-text" x="14" y="30">void swap(int *a,</text>
        <text class="portada-face-text" x="14" y="46" opacity=".75">
          int *b) &#123;</text
        >
        <text class="portada-face-text" x="14" y="62" opacity=".75">
          int t = *a;</text
        >
        <text class="portada-face-text" x="14" y="78" opacity=".75">
          *a = *b;</text
        >
        <text class="portada-face-text" x="14" y="94" opacity=".75">
          *b = t;</text
        >
        <text class="portada-face-text" x="14" y="110">&#125;</text>
      </g>

      <ellipse
