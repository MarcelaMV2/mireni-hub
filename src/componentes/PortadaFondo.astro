</div>

<script>
  const blades = document.querySelector("#portada-blades");
  const svgNamespace = "http://www.w3.org/2000/svg";

  if (blades) {
    for (let index = 0; index < 20; index += 1) {
      const angle = (index / 20) * Math.PI * 2;
      const line = document.createElementNS(svgNamespace, "line");
      line.setAttribute("x1", String(260 + 16 * Math.cos(angle)));
      line.setAttribute("y1", String(205 + 9.2 * Math.sin(angle)));
      line.setAttribute("x2", String(260 + 68 * Math.cos(angle)));
      line.setAttribute("y2", String(205 + 39 * Math.sin(angle)));
      blades.appendChild(line);
    }
  }
</script>
