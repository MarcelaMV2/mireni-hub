<div class="portada-stage" aria-hidden="true">
  <svg viewBox="0 0 520 560" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <symbol id="portada-mini" viewBox="0 0 20 23">
        <polygon points="10,0 20,5.75 10,11.5 0,5.75" fill="var(--cube-a)"
        ></polygon>
        <polygon points="0,5.75 10,11.5 10,23 0,17.25" fill="var(--cube-c)"
        ></polygon>
        <polygon points="10,11.5 20,5.75 20,17.25 10,23" fill="var(--cube-b)"
        ></polygon>
      </symbol>
      <radialGradient id="portada-ground" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="var(--color-cyan)" stop-opacity=".55"
        ></stop>
        <stop offset="1" stop-color="var(--color-cyan)" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="portada-beam" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="var(--color-cyan)" stop-opacity=".8"
        ></stop>
        <stop offset="1" stop-color="var(--color-cyan)" stop-opacity="0"></stop>
      </linearGradient>
      <filter id="portada-blur" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6"></feGaussianBlur>
      </filter>
      <filter id="portada-soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="2"></feGaussianBlur>
      </filter>
    </defs>

    <ellipse cx="260" cy="448" rx="190" ry="44" fill="url(#portada-ground)"
