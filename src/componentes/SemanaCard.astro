---
import { Icon } from "astro-icon/components";

interface Props {
  numero: number;
  titulo: string;
  resumen: string;
  estado: "disponible" | "bloqueada";
  href?: string;
}
const { numero, titulo, resumen, estado, href } = Astro.props;
const bloqueada = estado === "bloqueada";
const nn = String(numero).padStart(2, "0");

const Tag = bloqueada ? "div" : "a";
---

<Tag
  href={bloqueada ? undefined : href}
  class:list={["materia-week-card group", bloqueada ? "is-locked" : ""]}
>
  <span class="materia-week-number" aria-hidden="true">
    {nn}
  </span>

  <div class="materia-week-copy">
    <span class="materia-week-tag">Semana {numero}</span>
    {
      bloqueada ? (
        <h3>Semana {numero}</h3>
      ) : (
        <>
          <h3>{titulo}</h3>
          <p>{resumen}</p>
        </>
      )
    }
  </div>

  <div class="materia-week-action">
    {
      bloqueada ? (
        <span class="materia-week-locked">
          <Icon name="tabler:lock" width={13} height={13} />
          Próximamente
        </span>
      ) : (
        <span class="materia-week-go">
          Ver semana
          <Icon name="tabler:arrow-up-right" width={14} height={14} />
        </span>
      )
    }
  </div>
</Tag>
